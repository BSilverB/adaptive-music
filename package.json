{
  "name": "adaptive-flow-engine",
  "version": "1.0.0",
  "description": "Standalone Neuro-Focus Audio Workstation & Player",
  "main": "electron/main.cjs",
  "scripts": {
    "frontend:build": "npm --prefix frontend run build",
    "backend": "python backend/main.py --watchdog",
    "start": "electron .",
    "desktop": "npm run frontend:build && electron .",
    "pack": "npm run frontend:build && electron-builder --dir",
    "dist": "npm run frontend:build && electron-builder"
  },
  "keywords": [
    "audio",
    "deep-work",
    "stems",
    "dsp",
    "focus",
    "8d-audio"
  ],
  "author": "Adaptive Flow Team",
  "license": "MIT",
  "build": {
    "appId": "com.adaptivemusic.flowengine",
    "productName": "Adaptive Flow Engine",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!cache/**",
          "!01_Original_Audio/**",
          "!02_Processed_Audio/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Adaptive Flow Engine"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
