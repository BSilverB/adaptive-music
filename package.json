{
  "name": "adaptive-flow-engine",
  "version": "1.0.3",
  "description": "Standalone Neuro-Focus Audio Workstation & Player",
  "main": "electron/main.cjs",
  "scripts": {
    "frontend:build": "npm --prefix frontend run build",
    "backend:build": "python -m PyInstaller --clean --onefile --distpath backend --name backend_engine --exclude-module pkg_resources --exclude-module setuptools --exclude-module torch --exclude-module torchaudio --exclude-module torchvision --exclude-module matplotlib --exclude-module scipy backend/main.py",
    "backend": "python backend/main.py --watchdog",
    "start": "electron .",
    "desktop": "npm run frontend:build && electron .",
    "pack": "npm run frontend:build && electron-builder --dir",
    "dist": "npm run frontend:build && electron-builder",
    "release": "npm run frontend:build && electron-builder --publish always"
  },
  "keywords": [
    "audio",
    "deep-work",
    "stems",
    "dsp",
    "focus",
    "8d-audio"
  ],
  "author": "Adaptive Flow Team",
  "license": "MIT",
  "build": {
    "appId": "com.adaptivemusic.flowengine",
    "productName": "Adaptive Flow Engine",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BSilverB",
        "repo": "adaptive-music"
      }
    ],
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!cache_stems/**",
          "!sync_drive/**",
          "!active_port.json",
          "!01_Original_Audio/**",
          "!02_Processed_Audio/**",
          "!03_Output_Stems/**",
          "!*.mp3",
          "!*.wav",
          "!*.flac",
          "!*.ogg",
          "!*.m4a"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Adaptive-Flow-Engine-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Adaptive Flow Engine"
    },
    "portable": {
      "artifactName": "Adaptive-Flow-Engine-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
